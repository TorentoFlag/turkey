NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://turkiye:turkiye@127.0.0.1:5433/turkiye
LOG_LEVEL=info
ADMIN_API_KEY=change-me-to-a-long-random-secret
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=turkiye-catalog-media
MINIO_ACCESS_KEY=change-me-catalog-media-app-key
MINIO_SECRET_KEY=change-me-catalog-media-app-secret
MEDIA_PUBLIC_BASE_URL=https://shop.example.com/media
ARC_SECRET_API_KEY=
ARC_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=Turkey <noreply@your-verified-domain.example>
SLACK_WEBHOOK_URL=
# Для Arc Hosted Checkout укажите публичный HTTPS-origin витрины.
WEB_APP_ORIGIN=https://shop.example.com
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
WORKER_POLL_INTERVAL_MS=5000
